{
    "name": "http-evolution-slides",
    "compatibility_date": "2026-10-13",
    "workers_dev": false,
    "preview_urls": false,
    "routes": [
        {
            "pattern": "slides.podkolzin.consulting/http-evolution",
            "zone_name": "podkolzin.consulting"
        },
        {
            "pattern": "slides.podkolzin.consulting/http-evolution/*",
            "zone_name": "podkolzin.consulting"
        }
    ],
    "assets": {
        "directory": "./dist",
        "base_path": "/http-evolution"
    }
}
